// Step 11.5: invoices to customers and bills from suppliers, and the money paid against them.
// One table holds both, because they work the same way with the sides of the ledger swapped.

enum InvoiceKind {
  // To a customer: money they owe the business (receivable).
  SALE
  // From a supplier: money the business owes them (payable).
  BILL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  workspaceId    String        @map("workspace_id") @db.Uuid
  businessId     String        @map("business_id") @db.Uuid
  kind           InvoiceKind
  // Given when issued (INV-2026-000001 or BILL-2026-000001), so issued numbers have no gaps.
  number         String?
  status         InvoiceStatus @default(DRAFT)
  contactId      String        @map("contact_id") @db.Uuid
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  currency       String        @db.Char(3)
  // Before VAT, the VAT on it, and the two together (11.6). Without VAT, subtotal equals total.
  subtotalMinor  BigInt        @default(0) @map("subtotal_minor")
  vatMinor       BigInt        @default(0) @map("vat_minor")
  totalMinor     BigInt        @map("total_minor")
  // A bill's VAT can be claimed back only by a VAT-registered business. Fixed when issued.
  vatRecoverable Boolean       @default(false) @map("vat_recoverable")
  paidMinor      BigInt        @default(0) @map("paid_minor")
  // The supplier's own bill number, or a customer's order number.
  referenceNo    String?       @map("reference_no")
  notes          String?
  journalEntryId String?       @unique @map("journal_entry_id") @db.Uuid
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedBy       String?       @map("issued_by") @db.Uuid
  voidedAt       DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedBy       String?       @map("voided_by") @db.Uuid
  voidReason     String?       @map("void_reason")
  emailedAt      DateTime?     @map("emailed_at") @db.Timestamptz(3)
  createdBy      String        @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business         @relation(fields: [businessId], references: [id])
  contact      Contact          @relation(fields: [contactId], references: [id])
  journalEntry JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  lines        InvoiceLine[]
  payments     InvoicePayment[]

  @@unique([businessId, number])
  @@index([businessId, kind, status, dueDate])
  @@index([businessId, contactId])
  // The VAT summary reads invoices and bills by date.
  @@index([businessId, issueDate])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  businessId     String  @map("business_id") @db.Uuid
  lineNo         Int     @map("line_no") @db.SmallInt
  description    String
  quantity       Decimal @db.Decimal(12, 3)
  unitPriceMinor BigInt  @map("unit_price_minor")
  // quantity × unit price, rounded to the minor unit. Before VAT.
  amountMinor    BigInt  @map("amount_minor")
  // VAT in basis points (1500 is 15%), and the VAT on this line, rounded half up.
  vatRateBp      Int     @default(0) @map("vat_rate_bp")
  vatMinor       BigInt  @default(0) @map("vat_minor")
  // An income category on an invoice, an expense category on a bill. It picks the ledger account.
  categoryId     String  @map("category_id") @db.Uuid

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

model InvoicePayment {
  id                String    @id @default(uuid(7)) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  invoiceId         String    @map("invoice_id") @db.Uuid
  // Where the money landed (invoice) or left from (bill).
  accountId         String    @map("account_id") @db.Uuid
  paidOn            DateTime  @map("paid_on") @db.Date
  amountMinor       BigInt    @map("amount_minor")
  note              String?
  journalEntryId    String    @unique @map("journal_entry_id") @db.Uuid
  // A payment entered by mistake is undone by a reversing journal, never deleted.
  voidedAt          DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy          String?   @map("voided_by") @db.Uuid
  reversalJournalId String?   @unique @map("reversal_journal_id") @db.Uuid
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  account         FinancialAccount @relation(fields: [accountId], references: [id])
  journalEntry    JournalEntry     @relation("InvoicePaymentJournal", fields: [journalEntryId], references: [id])
  reversalJournal JournalEntry?    @relation("InvoicePaymentReversal", fields: [reversalJournalId], references: [id])

  @@index([invoiceId, paidOn])
  @@map("invoice_payments")
}
