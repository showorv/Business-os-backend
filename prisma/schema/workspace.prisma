model Workspace {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  // Unused since Phase 11: the plan lives in workspace_subscriptions.
  plan        String   @default("private")
  // Who signed up and created it. Only they manage its plan and payments.
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner         User?                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  subscription  WorkspaceSubscription?
  users         UserWorkspace[]
  businesses    Business[]
  roles         Role[]
  exchangeRates ExchangeRate[]

  @@index([ownerUserId])
  @@map("workspaces")
}

model UserWorkspace {
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  isDefault   Boolean  @default(true) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("user_workspaces")
}
