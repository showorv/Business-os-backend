NODE_ENV=development
PORT=5001
LOG_LEVEL=info
# Reverse proxies in front of the API (0 = none, 1 = Nginx/Caddy). Needed for the real client IP.
TRUST_PROXY=0

# Local Docker Postgres. For Neon, DATABASE_URL is the pooled URL and DIRECT_DATABASE_URL is the
# direct one (same host without "-pooler"), which `prisma migrate` needs.
DATABASE_URL=postgresql://business_os:business_os@localhost:5432/business_os
DIRECT_DATABASE_URL=postgresql://business_os:business_os@localhost:5432/business_os
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Set to false once your own account exists, so nobody else can sign up.
REGISTRATION_ENABLED=true

# Generate each one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_MFA_SECRET=change-me-too-change-me-too-change-me-too
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
# Only for a shared parent domain, e.g. .example.com when the SPA and API use different subdomains.
COOKIE_DOMAIN=

# S3-compatible storage for documents. These defaults match MinIO in docker-compose.yml.
# In production use Cloudflare R2 or S3, and an endpoint that browsers can reach.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=business_os
S3_SECRET_KEY=business_os_dev
S3_BUCKET=business-os-documents

# Set to true if PDF exports fail in a container because Chrome can't start its sandbox.
CHROME_NO_SANDBOX=false

# The web app's address, used for links in emails.
APP_URL=http://localhost:5173

# Email. This default is Mailpit from docker-compose.yml: open http://localhost:8025 to read what was sent.
# In production use your provider's SMTP address. Leave empty to switch email off.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Business OS <no-reply@localhost>

# Web push. Generate the pair with: npx web-push generate-vapid-keys. Leave empty to switch push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Queue screen at /admin/queues, signed in as "admin". At least 12 characters. Leave empty to switch it off.
BULL_BOARD_PASSWORD=

# The AI assistant. Any service with an OpenAI-style API; the defaults are Groq (console.groq.com).
# Leave the key empty to switch the assistant off. Document search still works, because it runs here.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_MODEL=openai/gpt-oss-120b
# The most tokens one workspace may use in a day. Groq's free plan allows 200,000.
AI_DAILY_TOKEN_LIMIT=100000

# A ClamAV daemon for scanning uploads. Leave empty to switch scanning off.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Optional. Leave empty to switch the integration off.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
